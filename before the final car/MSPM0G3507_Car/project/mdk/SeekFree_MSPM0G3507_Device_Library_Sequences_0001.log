[15:51:19.537]        // -> [partNum <= 0x00000000]
[15:51:19.537]      __var manuf = 0;
[15:51:19.539]        // -> [manuf <= 0x00000000]
[15:51:19.539]      __var isMSPM0G1X0X_G3X0X = 0;
[15:51:19.539]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:51:19.539]      __var isProduction = 0;
[15:51:19.539]        // -> [isProduction <= 0x00000000]
[15:51:19.539]      __var continueId = 0;
[15:51:19.539]        // -> [continueId <= 0x00000000]
[15:51:19.539]      deviceID =   Read32(0x41C40004);
[15:51:19.546]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:51:19.546]        // -> [deviceID <= 0x2BB8802F]
[15:51:19.546]      version = deviceID >> 28;
