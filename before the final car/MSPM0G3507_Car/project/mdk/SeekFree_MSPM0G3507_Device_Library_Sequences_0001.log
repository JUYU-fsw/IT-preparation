[15:53:25.224]          // skip if-block "hasDormant"
[15:53:25.224]        </control>
[15:53:25.224]        <control if="!hasDormant" while="" timeout="0" info="">
[15:53:25.224]          // if-block "!hasDormant"
[15:53:25.224]            // =>  TRUE
[15:53:25.224]          <block atomic="false" info="">
[15:53:25.224]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:53:25.227]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:53:25.227]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:53:25.229]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:53:25.229]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:53:25.229]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:53:25.232]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
