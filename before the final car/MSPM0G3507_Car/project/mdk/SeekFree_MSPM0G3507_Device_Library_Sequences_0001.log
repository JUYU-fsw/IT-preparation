[15:53:25.250]      WriteDP(DP_SELECT, 0x00000000);
[15:53:25.252]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:53:25.252]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:53:25.255]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:53:25.255]        // -> [powered_down <= 0x00000001]
