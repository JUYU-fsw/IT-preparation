[15:53:25.261]        <block atomic="false" info="">
[15:53:25.266]          Message(0, "executing SWD power up");
[15:53:25.266]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:53:25.266]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
